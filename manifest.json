{
  "manifest_version": 3,
  "name": "AI Chat TOC & Navigator - ChatGPT & Gemini",
  "version": "1.0.0",
  "description": "Sidebar mục lục tự động cho ChatGPT và Gemini, giúp chuyển nhanh đến các đoạn chat mà không cần cuộn thủ công.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AI Chat TOC Navigator"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

